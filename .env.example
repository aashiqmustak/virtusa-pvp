# Local development only. Choose distinct long tokens; never commit your .env.
POSTGRES_PASSWORD=local-db-change-me
ANALYST_TOKEN=local-analyst-change-me
REVIEWER_TOKEN=local-reviewer-change-me
LLM_MODE=mock
# Set ollama mode only after checking local RAM/VRAM and testing a quantized model.
OLLAMA_MODEL=
LLM_TIMEOUT=45
LLM_RETRIES=1
DOCUMENT_TIMEOUT=90
# For a local Python process only; Docker Compose supplies PostgreSQL automatically.
# DATABASE_URL=sqlite:///./demo.db
# PRIVATE_STORAGE=./private_uploads
# POLICY_FILE=../policy.demo.json

# Voice: mock = typed Pipecat interview, no external calls.
# sarvam = microphone and Sarvam streaming STT/TTS. Key stays server-side.
VOICE_MODE=mock
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE=shubh
